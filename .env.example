# MongoDB connection (Atlas or self-hosted).
# Example Atlas value:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (defaults to bball_club).
MONGODB_DB=bball_club

# Long random string used to hash visitor IPs for rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Optional: image uploads in the admin (ImageKit). Without these the admin keeps using
# pasted https image URLs and shows no Upload button.
# Private key: ImageKit dashboard > Developer options > API keys. Server-only, never expose it.
IMAGEKIT_PRIVATE_KEY=
# URL endpoint: ImageKit dashboard > Developer options, e.g. https://ik.imagekit.io/your_id
IMAGEKIT_URL_ENDPOINT=
